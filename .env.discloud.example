# Variáveis para criar no painel da Discloud (app → Variáveis). Este arquivo é só o guia:
# copie para .env.discloud (fora do Git) se quiser que o "npm run discloud:zip" confira o que falta.
# Troque "pmerj" pelo ID (subdomínio) do discloud.config.

NODE_ENV=production
PORT=8080
TRUST_PROXY=true

WEB_ORIGIN=https://pmerj.discloud.app
# Cadastre exatamente esta URL no Discord Developer Portal → OAuth2 → Redirects
DISCORD_REDIRECT_URI=https://pmerj.discloud.app/api/auth/discord/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=

PAINEL_ADMIN_IDS=
PAINEL_ADMIN_ROLE_IDS=

# Banco MongoDB da Discloud (o mesmo tipo usado no sistema do BOPE). Obrigatório em produção.
# Ex.: mongodb://usuario:senha@host:porta/pmerj?authSource=admin
MONGODB_URI=
