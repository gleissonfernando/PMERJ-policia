# Copie para .env e preencha. NUNCA versione o arquivo .env.

NODE_ENV=development
PORT=3333

# Endereço do site (em dev, o Vite)
WEB_ORIGIN=http://localhost:5173

# Discord Developer Portal → sua aplicação → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Cadastre exatamente esta URL em OAuth2 → Redirects
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback

# ID do servidor da PMERJ. Vazio = qualquer conta do Discord entra (somente dev).
# Obrigatório em produção.
DISCORD_GUILD_ID=

SESSION_TTL_HOURS=8
# true somente atrás de proxy reverso confiável (Nginx/Cloudflare)
TRUST_PROXY=false

# ---------- Bot do Discord (opcional) ----------
# Developer Portal → sua aplicação → Bot → Reset Token. Precisa de DISCORD_GUILD_ID.
# No Developer Portal → Bot, ligue "Server Members Intent" (anúncios de entrada/saída).
# Permissões no servidor: Gerenciar Apelidos, Ver Canais, Enviar Mensagens, Inserir Links.
# O cargo do bot precisa ficar ACIMA dos cargos dos policiais.
# Canais de anúncio, log do set e painel "Pedir Set" são escolhidos no próprio site.
DISCORD_BOT_TOKEN=

# ---------- Administração do painel ----------
# IDs do Discord separados por vírgula. Vazio nos dois = em dev todos são admin;
# em produção, ninguém.
PAINEL_ADMIN_IDS=
PAINEL_ADMIN_ROLE_IDS=
